{
  "$defs": {
    "ActionDimension": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "group": {
          "minLength": 1,
          "title": "Group",
          "type": "string"
        },
        "masked": {
          "title": "Masked",
          "type": "boolean"
        },
        "constant": {
          "default": false,
          "description": "The value never varies in valid data (G1 dim 31: base height 0.74 in psi-data). A std of 0 here is expected, not a stats defect (design D4); the normalizer must keep the value unchanged. A masked dim may also be constant.",
          "title": "Constant",
          "type": "boolean"
        },
        "limit_low": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Limit Low"
        },
        "limit_high": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Limit High"
        }
      },
      "required": [
        "name",
        "group",
        "masked"
      ],
      "title": "ActionDimension",
      "type": "object"
    },
    "ActionLayout": {
      "additionalProperties": false,
      "properties": {
        "dimensions": {
          "items": {
            "$ref": "#/$defs/ActionDimension"
          },
          "minItems": 1,
          "title": "Dimensions",
          "type": "array"
        }
      },
      "required": [
        "dimensions"
      ],
      "title": "ActionLayout",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Configuration for an embodiment / robot embodiment.",
  "properties": {
    "name": {
      "title": "Name",
      "type": "string"
    },
    "version": {
      "default": "1.0.0",
      "title": "Version",
      "type": "string"
    },
    "domain": {
      "default": "sim",
      "enum": [
        "sim",
        "real"
      ],
      "title": "Domain",
      "type": "string"
    },
    "controller": {
      "default": "sonic_dwbc",
      "title": "Controller",
      "type": "string"
    },
    "camera_ref_hash": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Camera Ref Hash"
    },
    "action_layout": {
      "anyOf": [
        {
          "$ref": "#/$defs/ActionLayout"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "meta": {
      "additionalProperties": true,
      "title": "Meta",
      "type": "object"
    }
  },
  "required": [
    "name"
  ],
  "title": "EmbodimentConfig",
  "type": "object"
}
