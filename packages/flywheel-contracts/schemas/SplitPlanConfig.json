{
  "$defs": {
    "SeedRange": {
      "additionalProperties": false,
      "description": "Half-open seed range [start, stop).",
      "properties": {
        "start": {
          "title": "Start",
          "type": "integer"
        },
        "stop": {
          "title": "Stop",
          "type": "integer"
        }
      },
      "required": [
        "start",
        "stop"
      ],
      "title": "SeedRange",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Configuration for dataset split rules, seed ranges, and duplicate guards.",
  "properties": {
    "name": {
      "default": "default",
      "title": "Name",
      "type": "string"
    },
    "version": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "string"
        }
      ],
      "default": 1,
      "title": "Version"
    },
    "seed_ranges": {
      "additionalProperties": {
        "anyOf": [
          {
            "$ref": "#/$defs/SeedRange"
          },
          {
            "items": {
              "type": "integer"
            },
            "type": "array"
          }
        ]
      },
      "title": "Seed Ranges",
      "type": "object"
    },
    "author_ranges_to_avoid": {
      "items": {
        "items": {
          "type": "integer"
        },
        "type": "array"
      },
      "title": "Author Ranges To Avoid",
      "type": "array"
    },
    "near_duplicate_threshold_d_dup": {
      "default": 0.05,
      "title": "Near Duplicate Threshold D Dup",
      "type": "number"
    },
    "meta": {
      "additionalProperties": true,
      "title": "Meta",
      "type": "object"
    }
  },
  "title": "SplitPlanConfig",
  "type": "object"
}
