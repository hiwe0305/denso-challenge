{
  "additionalProperties": false,
  "description": "External or ingested raw data source with lineage and provenance.",
  "properties": {
    "site_id": {
      "default": "local",
      "title": "Site Id",
      "type": "string"
    },
    "task_id": {
      "default": "default",
      "title": "Task Id",
      "type": "string"
    },
    "embodiment_id": {
      "default": "default",
      "title": "Embodiment Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "meta": {
      "additionalProperties": true,
      "title": "Meta",
      "type": "object"
    },
    "id": {
      "default": "",
      "title": "Id",
      "type": "string"
    },
    "kind": {
      "default": "dataset",
      "enum": [
        "dataset",
        "checkpoint",
        "video_upload",
        "code"
      ],
      "title": "Kind",
      "type": "string"
    },
    "uri": {
      "title": "Uri",
      "type": "string"
    },
    "repo": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Repo"
    },
    "revision": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Revision"
    },
    "path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Path"
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Sha256",
      "type": "string"
    },
    "license": {
      "default": "unknown",
      "title": "License",
      "type": "string"
    },
    "data_class": {
      "default": "restricted",
      "enum": [
        "public",
        "internal",
        "restricted"
      ],
      "title": "Data Class",
      "type": "string"
    },
    "clean_for_main_task": {
      "default": "unknown",
      "enum": [
        "true",
        "false",
        "unknown"
      ],
      "title": "Clean For Main Task",
      "type": "string"
    },
    "provenance": {
      "additionalProperties": true,
      "title": "Provenance",
      "type": "object"
    },
    "downloaded_at": {
      "title": "Downloaded At",
      "type": "string"
    }
  },
  "required": [
    "uri",
    "sha256",
    "downloaded_at"
  ],
  "title": "Source",
  "type": "object"
}
