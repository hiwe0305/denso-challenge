{
  "name": "flywheel-web-fe",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "gen:types": "node scripts/gen-contract-types.mjs",
    "check:types": "node scripts/gen-contract-types.mjs --check"
  },
  "dependencies": {
    "@tanstack/react-query": "5.62.7",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.28.0",
    "recharts": "2.13.3"
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "@testing-library/react": "16.1.0",
    "@types/node": "22.10.2",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "eslint": "9.17.0",
    "eslint-plugin-react-hooks": "5.1.0",
    "globals": "15.14.0",
    "jsdom": "25.0.1",
    "json-schema-to-typescript": "15.0.3",
    "msw": "2.6.6",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.17",
    "typescript": "5.6.3",
    "typescript-eslint": "8.18.1",
    "vite": "5.4.11",
    "vitest": "2.1.8"
  },
  "msw": {
    "workerDirectory": ["public"]
  }
}
